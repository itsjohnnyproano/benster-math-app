{
  "expo": {
    "name": "math-sprint",
    "slug": "math-sprint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/math-sprint-app-icon.png",
    "scheme": "mathsprint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.itsjohnnyproano.math-sprint",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/math-sprint-app-icon.png",
        "backgroundColor": "#F6F3FF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/math-sprint-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3FF",
          "image": "./assets/branding/math-sprint-app-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "daba7c22-c903-4f2e-ab0e-0c56586516e7"
      }
    }
  }
}
